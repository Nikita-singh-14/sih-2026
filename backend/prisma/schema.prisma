generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STATE_ADMINISTRATOR
  LEGAL_METROLOGY_OFFICER
  GATC_OPERATOR
  APPLICANT_BUSINESS
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           UserRole      @default(APPLICANT_BUSINESS)
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  notifications  Notification[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organisationId])
}

model Organisation {
  id                   String                 @id @default(uuid())
  name                 String
  email                String?
  phone                String?
  gstin                String?
  lmRegistrationNo     String?
  address              String?
  jurisdiction         String?
  expiryAlertDays      Int                    @default(30)
  users                User[]
  instruments          Instrument[]
  applications         Application[]
  certificates         Certificate[]
  scheduledInspections ScheduledInspection[]
  premises             Premises[]
  notifications        Notification[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Instrument {
  id                   String                 @id @default(uuid())
  platformId           String                 @unique
  type                 String
  manufacturer         String
  model                String
  serialNumber         String
  capacity             String?
  accuracyClass        String?                @default("Class III")
  premises             String?
  location             String
  status               String                 @default("Pending Verification")
  lastVerified         String?                @default("Not yet verified")
  nextDue              String?                @default("Immediate verification required")
  certificateNo        String?                @default("Pending Registration")
  sealNo               String?                @default("Unstamped")
  ownerId              String
  owner                Organisation           @relation(fields: [ownerId], references: [id])
  applications         Application[]
  certificates         Certificate[]
  scheduledInspections ScheduledInspection[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([ownerId])
  @@index([status])
}

model Application {
  id              String             @id @default(uuid())
  applicationNo   String             @unique
  type            String
  status          String             @default("Under review")
  instrumentId    String
  instrument      Instrument         @relation(fields: [instrumentId], references: [id])
  instrumentName  String?
  location        String?
  applicantId     String
  applicant       Organisation       @relation(fields: [applicantId], references: [id])
  assignedOfficer String?            @default("Officer Allocation Pending")
  scheduledDate   String?
  feeAmount       Float              @default(1500)
  feePaid         Boolean            @default(true)
  remarks         String?
  submittedAt     DateTime?          @default(now())
  events          ApplicationEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([instrumentId])
  @@index([applicantId])
}

model ApplicationEvent {
  id             String       @id @default(uuid())
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus      String
  reason         String?
  actorId        String?
  createdAt      DateTime     @default(now())

  @@index([applicationId, createdAt])
}

model Certificate {
  id             String       @id @default(uuid())
  certificateNo  String       @unique
  instrumentId   String
  instrument     Instrument   @relation(fields: [instrumentId], references: [id])
  instrumentName String
  premises       String
  issuedDate     String
  expiryDate     String
  status         String       @default("Valid")
  issuedBy       String
  sealNumber     String
  qrCodeUrl      String?
  downloadUrl    String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
  @@index([instrumentId])
}

model ScheduledInspection {
  id                 String       @id @default(uuid())
  title              String
  applicationId      String?
  instrumentId       String?
  instrument         Instrument?  @relation(fields: [instrumentId], references: [id])
  premises           String
  scheduledDate      String
  timeSlot           String
  officerName        String
  officerPhone       String
  officerDesignation String
  status             String       @default("Scheduled")
  checklistReady     Boolean      @default(true)
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organisationId])
}

model Premises {
  id                     String       @id @default(uuid())
  name                   String
  address                String
  district               String
  managerName            String
  managerPhone           String
  activeInstrumentsCount Int          @default(0)
  complianceScore        Int          @default(100)
  organisationId         String
  organisation           Organisation @relation(fields: [organisationId], references: [id])
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organisationId])
}

model LicensedRepairer {
  id             String   @id @default(uuid())
  name           String
  licenseNo      String   @unique
  specialization String
  phone          String
  email          String
  rating         Float    @default(5.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id             String        @id @default(uuid())
  title          String
  detail         String
  unread         Boolean       @default(true)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([organisationId])
}
